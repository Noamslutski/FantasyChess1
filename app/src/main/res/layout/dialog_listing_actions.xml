<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="18dp">

    <FrameLayout
        android:layout_width="170dp"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/listing_dialog_card"
            layout="@layout/item_player_card" />
    </FrameLayout>

    <TextView
        android:id="@+id/listing_dialog_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/gold"
        android:textSize="16sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/listing_dialog_buy"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/gold"
        android:text="@string/market_buy_now"
        android:textColor="@color/deep_navy"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/listing_dialog_bid_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/listing_dialog_bid_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints=""
            android:background="@drawable/bg_surface_rounded"
            android:inputType="number"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/listing_dialog_bid_button"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/electric_blue"
            android:text="@string/market_place_bid" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/listing_dialog_offer"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/market_make_offer"
        android:textColor="@color/text_primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/listing_dialog_cancel_listing"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/market_cancel_listing"
        android:textColor="@color/loss_red"
        android:visibility="gone" />
</LinearLayout>
